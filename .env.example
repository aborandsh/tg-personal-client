# --- Telegram credentials (from https://my.telegram.org → API development tools)
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef

# --- Token the mobile app must send (x-api-token header or Bearer)
CLIENT_TOKEN=generate-a-long-random-string-here

# --- Admin dashboard
ADMIN_USER=admin
# sha256 of your password:  node -e "console.log(require('crypto').createHash('sha256').update('YOURPASS').digest('hex'))"
ADMIN_PASSWORD_HASH=

# --- Paths (Railway Volume must be mounted at /data)
TDLIB_DIR=/data/tdlib
FILES_DIR=/data/tdlib/files

PORT=3000
